
pipeline {
    agent any

    stages {
        stage('Build') {
            steps {
                dir('9-Jenkins-MultiStage-Pipeline') {
                    echo 'Creating virtual environment and installing dependencies...'
                    sh '''
                        python3 -m venv venv
                        venv/bin/pip install -r requirements.txt
                    '''
                }
            }
        }

        stage('Test') {
            steps {
                dir('9-Jenkins-MultiStage-Pipeline') {
                    echo 'Running unit tests...'
                    sh 'venv/bin/python -m unittest discover -s .'
                }
            }
        }

        stage('Deploy') {
            steps {
                dir('9-Jenkins-MultiStage-Pipeline') {
                    echo 'Deploying application...'
                    sh '''
                        mkdir -p ${WORKSPACE}/python-app-deploy
                        cp app.py ${WORKSPACE}/python-app-deploy/
                    '''
                }
            }
        }

        stage('Run Application') {
            steps {
                dir('9-Jenkins-MultiStage-Pipeline') {
                    echo 'Starting Flask application...'
                    sh '''
                        nohup ${WORKSPACE}/9-Jenkins-MultiStage-Pipeline/venv/bin/python \
                            ${WORKSPACE}/python-app-deploy/app.py \
                            > ${WORKSPACE}/python-app-deploy/app.log 2>&1 &
                        echo $! > ${WORKSPACE}/python-app-deploy/app.pid
                    '''
                }
            }
        }

        stage('Test Application') {
            steps {
                dir('9-Jenkins-MultiStage-Pipeline') {
                    echo 'Testing deployed application...'
                    sh '''
                        for i in $(seq 1 10); do
                            if curl -fsS http://127.0.0.1:5000/; then
                                echo
                                exit 0
                            fi
                            sleep 2
                        done
                        cat ${WORKSPACE}/python-app-deploy/app.log
                        exit 1
                    '''
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline completed successfully!'
        }
        failure {
            echo 'Pipeline failed. Check the logs for more details.'
        }
    }
}
